<resources>
    <style name="Theme.CarrierID" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/one_bg</item>
    </style>

    <!-- Transparent window for the bottom panels (call note, live text) -->
    <style name="Theme.CarrierID.Panel" parent="Theme.CarrierID">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Translucent</item>
    </style>
</resources>
